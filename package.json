    "feelin": "^8.2.0",
    "temporal-polyfill": "^1.0.8"
  },
  "devDependencies": {
    "chai": "^6.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-bpmn-io": "^2.0.2",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.9",
    "npm-run-all2": "^7.0.2"
  }
